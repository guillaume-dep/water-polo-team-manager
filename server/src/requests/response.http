############################################################
# CREATE RESPONSE
############################################################

### Player membre → 201
POST http://localhost:3000/groups/{{groupId}}/events/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{playerToken}}

{
  "status": "present",
  "comment": "Je serai présent"
}

###

### Deuxième réponse du même joueur → 409
# Vérifie l'index unique { events, user }
POST http://localhost:3000/groups/{{groupId}}/events/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{playerToken}}

{
  "status": "absent",
  "comment": "Je change finalement d'avis"
}

###

### Coach → 403
POST http://localhost:3000/groups/{{groupId}}/events/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{coachToken}}

{
  "status": "present",
  "comment": "Réponse du coach"
}

###

### Autre coach → 403
POST http://localhost:3000/groups/{{groupId}}/events/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{otherCoachToken}}

{
  "status": "present",
  "comment": "Réponse interdite"
}

###

### Sans token → 401
POST http://localhost:3000/groups/{{groupId}}/events/{{eventId}}/responses
Content-Type: application/json

{
  "status": "present",
  "comment": "Test"
}

###

### Status invalide → 400
POST http://localhost:3000/groups/{{groupId}}/events/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{playerToken}}

{
  "status": "invalid_status",
  "comment": "Test"
}

###

### Status absent → 400
POST http://localhost:3000/groups/{{groupId}}/events/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{playerToken}}

{
  "comment": "Test"
}

###

### events inexistant → 404
POST http://localhost:3000/groups/{{groupId}}/events/000000000000000000000000/responses
Content-Type: application/json
Cookie: token={{playerToken}}

{
  "status": "present",
  "comment": "Test"
}

###

### Groupe inexistant → 404
POST http://localhost:3000/groups/000000000000000000000000/events/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{playerToken}}

{
  "status": "present",
  "comment": "Test"
}

###

### events d'un autre groupe → 404
# Le joueur ne doit pas pouvoir utiliser un eventId
# appartenant à un autre groupe.
POST http://localhost:3000/groups/{{groupId}}/events/{{otherEventId}}/responses
Content-Type: application/json
Cookie: token={{playerToken}}

{
  "status": "present",
  "comment": "Tentative d'accès"
}


