@groupId = 6a78a4a613e2f985e6098a91
@eventId = 6a78a4e713e2f985e6098a92

###

# ============================================================
# CREATE RESPONSE
# ============================================================

# Player membre → 201
POST http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{playerToken}}

{
    "status": "present",
    "comment": "Je serai présent"
}

###

# Player → deuxième réponse au même événement
# Doit être refusée par l'index unique
POST http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{playerToken}}

{
    "status": "absent",
    "comment": "Je change finalement d'avis"
}

###

# Coach → 403
POST http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{coachToken}}

{
    "status": "present",
    "comment": "Réponse du coach"
}

###

# Autre coach → 403
POST http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{otherCoachToken}}

{
    "status": "present",
    "comment": "Réponse interdite"
}

###

# Sans token → 401
POST http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses
Content-Type: application/json

{
    "status": "present",
    "comment": "Test"
}

###

# Status invalide → 400
POST http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses
Content-Type: application/json
Cookie: token={{playerToken}}

{
    "status": "invalid_status",
    "comment": "Test"
}

###

# ============================================================
# GET RESPONSES
# ============================================================

# Player membre → 200
GET http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses
Cookie: token={{playerToken}}

###

# Coach du groupe → 200
GET http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses
Cookie: token={{coachToken}}

###

# Autre coach → 403
GET http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses
Cookie: token={{otherCoachToken}}

###

# Sans token → 401
GET http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses

###

# Événement inexistant → 404
GET http://localhost:3000/groups/{{groupId}}/event/000000000000000000000000/responses
Cookie: token={{playerToken}}

###

# ============================================================
# UPDATE MY RESPONSE
# ============================================================

# Player → 200
PUT http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses/me
Content-Type: application/json
Cookie: token={{playerToken}}

{
    "status": "absent",
    "comment": "Je ne pourrai finalement pas venir"
}

###

# Player → modification partielle
PUT http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses/me
Content-Type: application/json
Cookie: token={{playerToken}}

{
    "comment": "Nouveau commentaire"
}

###

# Coach → 403
PUT http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses/me
Content-Type: application/json
Cookie: token={{coachToken}}

{
    "status": "present"
}

###

# Autre coach → 403
PUT http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses/me
Content-Type: application/json
Cookie: token={{otherCoachToken}}

{
    "status": "present"
}

###

# Sans token → 401
PUT http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses/me
Content-Type: application/json

{
    "status": "present"
}

###

# Status invalide → 400
PUT http://localhost:3000/groups/{{groupId}}/event/{{eventId}}/responses/me
