@groupId = 6a8311231201db855120c839
@groupCode = 508568

###############################################################################

# GROUP — SEARCH

###############################################################################

### Rechercher un groupe par son code

# Attendu : 200

# Un joueur authentifié peut rechercher un groupe.

# La réponse ne doit contenir que les informations publiques.

GET http://localhost:3000/groups?code={{groupCode}}
Cookie: token={{playerToken}}

###

### Rechercher un groupe avec un coach

# Attendu : 200

GET http://localhost:3000/groups?code={{groupCode}}
Cookie: token={{coachToken}}

###

### Rechercher un groupe sans code

# Attendu : 400

GET http://localhost:3000/groups
Cookie: token={{playerToken}}

###

### Rechercher un groupe inexistant

# Attendu : 404

GET http://localhost:3000/groups?code=abcdef
Cookie: token={{playerToken}}

###

### Rechercher un groupe avec un code malformé

# Attendu : 404

GET http://localhost:3000/groups?code=bonjour
Cookie: token={{playerToken}}

###

### Rechercher un groupe sans token

# Attendu : 401

GET http://localhost:3000/groups?code={{groupCode}}

###############################################################################

# GROUP — CREATE

###############################################################################

### Créer un groupe avec un coach

# Attendu : 201

POST http://localhost:3000/groups
Content-Type: application/json
Cookie: token={{coachToken}}

{
"name": "U18 Masculins"
}

###

### Créer un groupe avec un joueur

# Attendu : 403

POST http://localhost:3000/groups
Content-Type: application/json
Cookie: token={{playerToken}}

{
"name": "Groupe interdit"
}

###

### Créer un groupe sans nom

# Attendu : 400

POST http://localhost:3000/groups
Content-Type: application/json
Cookie: token={{coachToken}}

{}

###

### Créer un groupe avec un nom vide

# Attendu : 400

POST http://localhost:3000/groups
Content-Type: application/json
Cookie: token={{coachToken}}

{
"name": ""
}

###

### Créer un groupe avec un nom composé uniquement d'espaces

# Attendu : 400

POST http://localhost:3000/groups
Content-Type: application/json
Cookie: token={{coachToken}}

{
"name": "     "
}

###

### Créer un groupe sans token

# Attendu : 401

POST http://localhost:3000/groups
Content-Type: application/json

{
"name": "Groupe sans authentification"
}

###

### Créer un groupe avec un token invalide

# Attendu : 401

POST http://localhost:3000/groups
Content-Type: application/json
Cookie: token=invalid.token.here

###############################################################################

# GROUP — MY GROUPS

###############################################################################

### Voir mes groupes — coach

# Attendu : 200

# Ne doit retourner que les groupes dont le coach est l'utilisateur.

GET http://localhost:3000/groups/me
Cookie: token={{coachToken}}

###

### Voir mes groupes — joueur

# Attendu : 200

# Ne doit retourner que les groupes dont le joueur est membre.

GET http://localhost:3000/groups/me
Cookie: token={{playerToken}}

###

### Voir mes groupes sans token

# Attendu : 401

GET http://localhost:3000/groups/me

###############################################################################

# GROUP — JOIN

###############################################################################

### Rejoindre un groupe avec son code

# Attendu : 200

POST http://localhost:3000/groups/join
Content-Type: application/json
Cookie: token={{playerToken}}

{
"code": "{{groupCode}}"
}

###

### Rejoindre un groupe sans code

# Attendu : 400

POST http://localhost:3000/groups/join
Content-Type: application/json
Cookie: token={{playerToken}}

{}

###

### Rejoindre un groupe inexistant

# Attendu : 404

POST http://localhost:3000/groups/join
Content-Type: application/json
Cookie: token={{playerToken}}

{
"code": "abcdef"
}

###

### Rejoindre deux fois le même groupe

# Attendu : 409

# À exécuter après le premier test de JOIN.

POST http://localhost:3000/groups/join
Content-Type: application/json
Cookie: token={{playerToken}}

{
"code": "{{groupCode}}"
}

###

### Un coach ne peut pas rejoindre un groupe comme joueur

# Attendu : 403

POST http://localhost:3000/groups/join
Content-Type: application/json
Cookie: token={{coachToken}}

{
"code": "{{groupCode}}"
}

###

### Rejoindre un groupe sans token

# Attendu : 401

POST http://localhost:3000/groups/join
Content-Type: application/json

{
"code": "{{groupCode}}"
}

###

### Rejoindre un groupe avec un token invalide

# Attendu : 401

POST http://localhost:3000/groups/join
Content-Type: application/json
Cookie: token=invalid.token.here

{
"code": "{{groupCode}}"
}

###############################################################################

# GROUP — LEAVE

###############################################################################

### Quitter un groupe

# Attendu : 200

# Le joueur doit être membre du groupe.

DELETE http://localhost:3000/groups/{{groupId}}/members/me
Cookie: token={{playerToken}}

###

### Quitter un groupe auquel on n'appartient pas

# Attendu : 403

# À exécuter après le premier LEAVE.

DELETE http://localhost:3000/groups/{{groupId}}/members/me
Cookie: token={{playerToken}}

###

### Un coach ne peut pas quitter un groupe comme joueur

# Attendu : 403

DELETE http://localhost:3000/groups/{{groupId}}/members/me
Cookie: token={{coachToken}}

###

### Quitter sans token

# Attendu : 401

DELETE http://localhost:3000/groups/{{groupId}}/members/me

###############################################################################

# GROUP — DELETE

###############################################################################

### Supprimer un groupe avec son coach

# Attendu : 200

# À exécuter en dernier car le groupe sera supprimé.

DELETE http://localhost:3000/groups/{{groupId}}
Cookie: token={{coachToken}}

###

### Un joueur ne peut pas supprimer un groupe

# Attendu : 403

DELETE http://localhost:3000/groups/{{groupId}}
Cookie: token={{playerToken}}

###

### Un autre coach ne peut pas supprimer le groupe

# Attendu : 403

# Le rôle COACH ne suffit pas : il doit être le propriétaire du groupe.

DELETE http://localhost:3000/groups/{{groupId}}
Cookie: token={{otherCoachToken}}

###

### Supprimer un groupe sans token

# Attendu : 401

DELETE http://localhost:3000/groups/{{groupId}}

###

### Supprimer un groupe avec un ID inexistant

# Attendu : 404

DELETE http://localhost:3000/groups/000000000000000000000000
Cookie: token={{coachToken}}

###

### Supprimer un groupe avec un ID invalide

# Attendu : 400

DELETE http://localhost:3000/groups/not-an-object-id
Cookie: token={{coachToken}}

###############################################################################

# GROUP — SECURITY / AUTHORIZATION

###############################################################################

### Accéder à une route protégée sans token

# Attendu : 401

GET http://localhost:3000/groups/me

###

### Token invalide

# Attendu : 401

GET http://localhost:3000/groups/me
Cookie: token=invalid.token.here

###

### Token malformé

# Attendu : 401

GET http://localhost:3000/groups/me
Cookie: token=bonjour

###

### Un joueur tente de créer un groupe

# Attendu : 403

POST http://localhost:3000/groups
Content-Type: application/json
Cookie: token={{playerToken}}

{
"name": "Tentative d'escalade de privilèges"
}

###

### Un coach tente d'utiliser une route réservée aux joueurs

# Attendu : 403

POST http://localhost:3000/groups/join
Content-Type: application/json
Cookie: token={{coachToken}}

{
"code": "{{groupCode}}"
}
